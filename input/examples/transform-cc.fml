/// url = 'http://hl7.org/fhir/uv/mapping-language/StructureMap/TransformCc'
/// name = 'TransformCc'
/// status = 'active'
/// description = 'Example demonstrating the cc transform to create a CodeableConcept'

uses "http://hl7.org/fhir/StructureDefinition/Encounter" as source
uses "http://hl7.org/fhir/StructureDefinition/Encounter" as target

// Create 3 codeableconcepts in the output, each demonstrating a different way to populate a CodeableConcept using cc()
group TransformCc(source src : Encounter, target tgt : Encounter) {
  src -> tgt.type = cc('http://example.org/cs', 'example', 'Example Code') "FullCoding";
  src -> tgt.type = cc('http://example.org/cs', 'example') "CodingWithoutDisplay";
  src -> tgt.type = cc('Non coded text') "TextOnlyCC";
}

