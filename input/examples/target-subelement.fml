/// url = 'http://hl7.org/fhir/uv/mapping-language/StructureMap/TargetSubelement'
/// name = 'TargetSubelement'
/// status = 'active'
/// description = 'Example demonstrating target sub-element access using dot notation'

uses "http://hl7.org/fhir/StructureDefinition/Observation" as source
uses "http://hl7.org/fhir/StructureDefinition/Observation" as target

group TargetSubelement(source src : Observation, target tgt : Observation) {
  // directly access sub-element without intermediate variable
  // This demonstration will swap the first component's value and the observation's value
  src.value -> tgt.component.value;
  src.component.value first -> tgt.value;
}
