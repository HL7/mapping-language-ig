/// url = 'http://hl7.org/fhir/uv/mapping-language/StructureMap/TransformTranslate'
/// name = 'TransformTranslate'
/// status = 'active'
/// description = 'Example demonstrating the translate transform using a ConceptMap for code mapping'

uses "http://hl7.org/fhir/StructureDefinition/Patient" as source
uses "http://hl7.org/fhir/StructureDefinition/Observation" as target

group TransformTranslate(source src : Patient, target tgt : Observation) {
  src.address as v -> tgt.component as t then {
    v.use as u -> t.code = translate(u, 'http://hl7.org/fhir/ConceptMap/101', 'CodeableConcept') "mapUse";
  } "Address";
}
